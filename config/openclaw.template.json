{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "lan",
    "controlUi": {
      "enabled": true,
      "allowedOrigins": ["http://localhost:18789", "https://openclaw-vps.tailb1b4fb.ts.net"\]
    }
  },
  "channels": {
    "defaults": {
      "groupPolicy": "allowlist"
    },
    "slack": {
      "enabled": true,
      "mode": "socket",
      "dmPolicy": "pairing"
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/openclaw/workspace",
      "model": {
        "primary": "anthropic/claude-sonnet-4-5"
      }
    }
  },
  "browser": {
    "enabled": true,
    "headless": true,
    "cdpUrl": "http://chromium:3000"
  },
  "tools": {
    "exec": {
      "ask": "always"
    }
  }
}
