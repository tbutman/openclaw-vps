{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "trustedProxies": ["127.0.0.1", "::1"],
    "tailscale": {
      "mode": "serve"
    },
    "auth": {
      "mode": "trusted-proxy",
      "trustedProxy": {
        "userHeader": "tailscale-user-login"
      },
      "allowTailscale": true
    },
    "controlUi": {
      "enabled": true,
      "allowedOrigins": ["https://openclaw-gateway.tailb1b4fb.ts.net"]
    }
  },
  "channels": {
    "defaults": {
      "groupPolicy": "allowlist"
    },
    "slack": {
      "enabled": true,
      "dmPolicy": "pairing"
    }
  },
  "agents": {
    "defaults": {
      "workspace": "/home/openclaw/workspace",
      "model": {
        "primary": "anthropic/claude-sonnet-4-5"
      }
    }
  },
  "browser": {
    "enabled": true,
    "headless": true,
    "cdpUrl": "http://chromium:3000"
  },
  "tools": {
    "exec": {
      "ask": "always"
    }
  }
}
